/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Origin

# CSP notes:
# - style-src keeps 'unsafe-inline' ONLY because Tailwind/React emit inline
#   style= attributes at runtime (no nonce/hash pipeline). script-src deliberately
#   has NO 'unsafe-inline'/'unsafe-eval', so script injection stays blocked.
# - object-src 'none' + base-uri 'self' are set explicitly (not inherited from
#   default-src) to block <object>/<embed> and <base>-tag injection.
# - frame-src carries blob: because every inline PDF preview (FilePreview,
#   E2EE ID scans, mailbox attachments, receipts) renders from a same-origin
#   blob: URL — without it Chrome blocks the frame and the previewer shows an
#   empty box. Safe because those blobs are re-wrapped with the mime type WE
#   classified on, so a mislabelled upload lands in the PDF viewer rather than
#   executing as same-origin HTML. Remote framing stays limited to Turnstile.
# - report-uri/report-to surface violations (early injection signal) to the
#   client-error collector on the Directus host.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Report-To: {"group":"csp-endpoint","max_age":10886400,"endpoints":[{"url":"https://directus.kscw.ch/kscw/csp-report"}]}
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://wiedisync.kscw.ch https://wiedisync.pages.dev https://directus.kscw.ch https://directus-dev.kscw.ch https://api.kscw.ch https://www.ssd-sporthallen.stadt-zuerich.ch data: blob:; connect-src 'self' https://directus.kscw.ch https://directus-dev.kscw.ch wss://directus.kscw.ch wss://directus-dev.kscw.ch https://api.kscw.ch https://api-dev.kscw.ch wss://api.kscw.ch https://challenges.cloudflare.com https://cloudflareinsights.com https://photon.komoot.io https://sentry-tunnel.kscw.ch https://places.googleapis.com https://kscw-push.lucanepa.workers.dev https://kscw-website.pages.dev; font-src 'self'; frame-src 'self' blob: https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri https://directus.kscw.ch/kscw/csp-report; report-to csp-endpoint
